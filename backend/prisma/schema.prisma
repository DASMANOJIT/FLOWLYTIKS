generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                       Int                     @id @default(autoincrement())
  name                     String?
  email                    String                  @unique
  password                 String
  cashfreeVendorId         String?                 @unique
  cashfreeSettlementStatus TeacherSettlementStatus @default(NOT_CONFIGURED)
  createdAt                DateTime                @default(now())
  students                 Student[]               @relation("AdminStudents")
  payments                 Payment[]               @relation("AdminPayments")
  gatewayOrders            PaymentGatewayOrder[]   @relation("AdminGatewayOrders")
  feeReminderLogs          FeeReminderLog[]
  classSchoolGroups        ClassSchoolGroup[]      @relation("AdminClassSchoolGroups")
  faculties                Faculty[]
}

model Student {
  id                 Int                   @id @default(autoincrement())
  adminId            Int?
  name               String
  phone              String                @unique
  email              String?               @unique
  password           String
  school             String
  class              String
  joinDate           DateTime              @default(now())
  monthlyFee         Int                   @default(600)
  isVerified         Boolean               @default(false)
  isTwoFactorEnabled Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  admin              Admin?                @relation("AdminStudents", fields: [adminId], references: [id], onDelete: SetNull)
  payments           Payment[]
  gatewayOrders      PaymentGatewayOrder[]
  feeReminderLogs    FeeReminderLog[]
  staffFollowUps     StaffStudentFollowUp[]

  @@index([adminId])
  @@index([class])
  @@index([school])
  @@index([joinDate])
}

model ClassSchoolGroup {
  id                   String   @id @default(cuid())
  adminId              Int
  className            String
  schoolName           String
  normalizedClassName  String
  normalizedSchoolName String
  whatsappGroupLink    String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  admin                Admin    @relation("AdminClassSchoolGroups", fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, normalizedClassName, normalizedSchoolName])
  @@index([adminId])
  @@index([normalizedClassName])
  @@index([normalizedSchoolName])
}

model FeeReminderLog {
  id             String   @id @default(cuid())
  studentId      Int
  adminId        Int?
  month          String
  academicYear   Int
  channel        String   @default("whatsapp")
  lastRemindedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  admin          Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@unique([studentId, month, academicYear, channel])
  @@index([studentId])
  @@index([adminId])
  @@index([month])
  @@index([academicYear])
  @@index([lastRemindedAt])
}

model EmailOtp {
  id          String    @id @default(cuid())
  email       String
  purpose     String    @default("login")
  otpHash     String
  attempts    Int       @default(0)
  expiresAt   DateTime
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([email, purpose], name: "EmailOtp_email_purpose_key")
}

model Staff {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  passwordHash     String
  role             String   @default("STAFF")
  isActive         Boolean  @default(true)
  verifiedAt       DateTime
  createdByAdminId  Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  studentFollowUps StaffStudentFollowUp[]
}

model StaffStudentFollowUp {
  id        String   @id @default(cuid())
  studentId Int
  staffId   String
  note      String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([studentId, createdAt])
  @@index([staffId])
}

model StaffCreationRequest {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String
  adminId          Int
  otpHash          String
  attempts         Int       @default(0)
  expiresAt        DateTime
  lastSentAt       DateTime  @default(now())
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AuthRateLimitEvent {
  id        String   @id @default(cuid())
  namespace String
  key       String
  createdAt DateTime @default(now())

  @@index([namespace, key, createdAt])
  @@index([createdAt])
}

model UserSession {
  id                 String    @id @default(cuid())
  role               String
  userId             String
  sessionTokenHash   String?   @unique
  deviceId           String?
  deviceName         String?
  userAgent          String?
  ipAddress          String?
  isActive           Boolean   @default(true)
  lastSeenAt         DateTime  @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  revokedReason      String?
  closingRequestedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([role, userId])
  @@index([role, userId, isActive, lastSeenAt])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([closingRequestedAt])
}

model Faculty {
  extraIncentiveOperationLock FacultyExtraIncentiveOperationLock?
  id                     String                         @id @default(cuid())
  adminId                Int?
  facultyId              String                         @unique
  username               String                         @unique
  passwordHash           String
  fullName               String
  email                  String?
  phone                  String                         @unique
  gender                 String?
  dob                    DateTime?
  address                String?
  designation            String?
  qualification          String?
  experienceYears        Int?
  joiningDate            DateTime
  employmentType         String?
  salaryType             SalaryType
  salaryAmount           Decimal?                       @db.Decimal(12, 2)
  paymentNotes           String?
  status                 FacultyStatus                  @default(ACTIVE)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  admin                  Admin?                         @relation(fields: [adminId], references: [id], onDelete: SetNull)
  bankAccounts           FacultyBankAccount[]
  workLedgerEntries      WorkLedgerEntry[]
  payrolls               FacultyEarningsPayroll[]
  legacyPayrolls         FacultyPayroll[]
  payouts                FacultyPayout[]
  paymentHistory         FacultyPaymentHistory[]
  paymentRecords         FacultyPaymentRecord[]
  extraIncentiveEntries  FacultyExtraIncentiveEntry[]
  extraIncentivePayments FacultyExtraIncentivePayment[]
  onlineClasses          FacultyOnlineClass[]
  googleConnection       FacultyGoogleConnection?
  googleOAuthStates      FacultyGoogleOAuthState[]
  notifications          Notification[]
  profilePictures        ProfilePicture[]

  @@index([adminId])
  @@index([status])
  @@index([createdAt])
}

model FacultyGoogleConnection {
  facultyId             String @id
  googleSubject         String?
  identityVerifiedAt    DateTime?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  meetBackoffUntil       DateTime?
  expiresAt             DateTime?
  scope                 String
  status                String @default("CONNECTED")
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
  faculty               Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model FacultyGoogleOAuthState {
  id                    String @id @default(cuid())
  facultyId             String
  launchTokenHash       String @unique
  stateHash             String? @unique
  browserNonceHash      String?
  oidcNonceHash         String?
  codeVerifierEncrypted String?
  expiresAt             DateTime
  launchedAt            DateTime?
  consumedAt            DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime @default(now())
  faculty               Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@index([expiresAt])
}

model WorkLedgerEntry {
  id                 String                 @id @default(cuid())
  facultyId          String
  date               DateTime               @db.Date
  shift              WorkLedgerShift
  amount             Decimal                @db.Decimal(12, 2)
  remarks            String?
  createdBy          String
  updatedBy          String?
  classesTaken       Int                    @default(1)
  hoursWorked        Decimal?               @db.Decimal(5, 2)
  subject            String?
  updatedByAdminId   Int?
  updatedByFacultyId String?
  updatedByName      String?
  updatedByRole      String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  faculty            Faculty                @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  audits             WorkLedgerEntryAudit[]

  @@unique([facultyId, date, shift])
  @@index([facultyId])
  @@index([date])
  @@index([shift])
  @@index([createdBy])
}

model WorkLedgerEntryAudit {
  id           String            @id @default(cuid())
  entryId      String?
  action       LedgerAuditAction
  changedBy    String
  previousData Json?
  newData      Json?
  createdAt    DateTime          @default(now())
  entry        WorkLedgerEntry?  @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@index([changedBy])
  @@index([createdAt])
}

model NotificationLog {
  id                String    @id @default(cuid())
  recipientType     String
  recipientId       String?
  recipientEmail    String?
  recipientPhone    String?
  channel           String
  eventType         String
  title             String
  message           String
  status            String    @default("PENDING")
  providerMessageId String?
  errorMessage      String?
  whatsappLink      String?
  relatedWeekStart  DateTime? @db.Date
  relatedWeekEnd    DateTime? @db.Date
  relatedPayrollId  String?
  relatedPayoutId   String?
  idempotencyKey    String    @unique
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  @@index([recipientType, recipientId])
  @@index([channel])
  @@index([eventType])
  @@index([status])
  @@index([relatedWeekStart, relatedWeekEnd])
  @@index([relatedPayrollId])
  @@index([relatedPayoutId])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorType    String
  actorId      String?
  actorName    String?
  action       String
  entityType   String
  entityId     String?
  description  String?
  metadataJson Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorType, actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model FacultyPayrollBatch {
  id          String                @id @default(uuid())
  batchNumber String                @unique
  weekStart   DateTime              @db.Date
  weekEnd     DateTime              @db.Date
  totalAmount Decimal               @default(0) @db.Decimal(12, 2)
  status      PayrollBatchStatus    @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime              @default(now())
  payrolls    FacultyPayroll[]
  auditLogs   FacultyPayrollAudit[]

  @@index([weekStart, weekEnd])
  @@index([status])
  @@index([createdAt])
}

model FacultyPayroll {
  id               String                  @id @default(uuid())
  facultyId        String
  batchId          String
  presentDays      Decimal                 @default(0) @db.Decimal(5, 2)
  halfDays         Decimal                 @default(0) @db.Decimal(5, 2)
  absentDays       Decimal                 @default(0) @db.Decimal(5, 2)
  calculatedAmount Decimal                 @default(0) @db.Decimal(12, 2)
  bonus            Decimal                 @default(0) @db.Decimal(12, 2)
  deduction        Decimal                 @default(0) @db.Decimal(12, 2)
  netAmount        Decimal                 @default(0) @db.Decimal(12, 2)
  paymentStatus    PayrollPaymentStatus    @default(PENDING)
  generatedAt      DateTime                @default(now())
  faculty          Faculty                 @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  batch            FacultyPayrollBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  paymentHistory   FacultyPaymentHistory[]

  @@unique([facultyId, batchId])
  @@index([facultyId])
  @@index([batchId])
  @@index([paymentStatus])
}

model FacultyPaymentHistory {
  id          String         @id @default(uuid())
  facultyId   String
  payrollId   String
  amount      Decimal        @db.Decimal(12, 2)
  paymentDate DateTime
  remarks     String?
  createdAt   DateTime       @default(now())
  faculty     Faculty        @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  payroll     FacultyPayroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@index([payrollId])
  @@index([paymentDate])
}

model FacultyPayrollAudit {
  id           String               @id @default(cuid())
  batchId      String?
  action       PayrollAuditAction
  changedBy    String
  previousData Json?
  newData      Json?
  createdAt    DateTime             @default(now())
  batch        FacultyPayrollBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([changedBy])
  @@index([createdAt])
}

model PayrollCycle {
  id           String                       @id @default(cuid())
  cycleNumber  String                       @unique
  startDate    DateTime                     @db.Date
  endDate      DateTime                     @db.Date
  status       FacultyEarningsPayrollStatus @default(DRAFT)
  ledgerLocked Boolean                      @default(false)
  createdBy    String?
  updatedBy    String?
  approvedBy   String?
  approvedAt   DateTime?
  paidBy       String?
  paidAt       DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  payrolls     FacultyEarningsPayroll[]

  @@unique([startDate, endDate])
  @@index([status])
  @@index([ledgerLocked])
  @@index([startDate, endDate])
  @@map("payroll_cycles")
}

model FacultyEarningsPayroll {
  id             String                       @id @default(cuid())
  facultyId      String
  payrollCycleId String
  totalEntries   Int                          @default(0)
  totalAmount    Decimal                      @default(0) @db.Decimal(12, 2)
  status         FacultyEarningsPayrollStatus @default(DRAFT)
  approvedBy     String?
  approvedAt     DateTime?
  paidBy         String?
  paidAt         DateTime?
  remarks        String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  faculty        Faculty                      @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  payrollCycle   PayrollCycle                 @relation(fields: [payrollCycleId], references: [id], onDelete: Cascade)
  payouts        FacultyPayout[]

  @@unique([facultyId, payrollCycleId])
  @@index([facultyId])
  @@index([payrollCycleId])
  @@index([status])
  @@index([approvedAt])
  @@index([paidAt])
  @@map("faculty_payrolls")
}

model FacultyBankAccount {
  id                           String                 @id @default(cuid())
  facultyId                    String
  payoutMode                   String                 @default("NONE")
  accountHolderName            String?
  accountNumber                String?
  ifscCode                     String?
  bankName                     String?
  branchName                   String?
  upiId                        String?
  panNumber                    String?
  payoutContactName            String?
  payoutContactPhone           String?
  payoutContactEmail           String?
  verificationStatus           BankVerificationStatus @default(PENDING)
  payoutEligible               Boolean                @default(false)
  payoutBlockedReason          String?
  payoutRemarks                String?
  payoutDetailsUpdatedBy       String?
  payoutDetailsUpdatedAt       DateTime?
  cashfreeBeneficiaryId        String?
  cashfreeBeneficiaryStatus    String?
  cashfreeBeneficiaryCreatedAt DateTime?
  cashfreeBeneficiaryUpdatedAt DateTime?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  faculty                      Faculty                @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@index([verificationStatus])
}

model FacultyPayout {
  id                  String                  @id @default(cuid())
  facultyId           String
  payrollId           String?
  amount              Decimal                 @db.Decimal(12, 2)
  status              FacultyPayoutStatus     @default(PENDING)
  referenceId         String?
  transactionId       String?
  gatewayReference    String?
  cashfreeTransferId  String?
  cashfreeReferenceId String?
  utr                 String?
  paymentMethod       String?
  payoutMode          String?
  payoutAmount        Decimal?                @db.Decimal(12, 2)
  paidAmount          Decimal?                @db.Decimal(12, 2)
  unpaidAmount        Decimal?                @db.Decimal(12, 2)
  failureReason       String?
  adminPayoutRemark   String?
  cashfreeStatus      String?
  idempotencyKey      String?                 @unique
  retryCount          Int                     @default(0)
  lastRetryAt         DateTime?
  payoutRequestedAt   DateTime?
  payoutProcessedAt   DateTime?
  payoutCompletedAt   DateTime?
  payoutFailedAt      DateTime?
  processingTimeMs    Int?
  createdBy           String?
  approvedBy          String?
  paidBy              String?
  createdAt           DateTime                @default(now())
  paidAt              DateTime?
  payoutDate          DateTime?
  updatedAt           DateTime                @updatedAt
  faculty             Faculty                 @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  payroll             FacultyEarningsPayroll? @relation(fields: [payrollId], references: [id], onDelete: SetNull)
  events              FacultyPayoutEvent[]

  @@index([facultyId])
  @@index([payrollId])
  @@index([status])
  @@index([cashfreeReferenceId])
  @@index([cashfreeTransferId])
}

model FacultyPayoutEvent {
  id                  String        @id @default(cuid())
  payoutId            String
  eventType           String
  oldStatus           String?
  newStatus           String?
  cashfreeReferenceId String?
  cashfreeTransferId  String?
  utr                 String?
  message             String?
  rawPayloadJson      Json?
  dedupeKey           String?       @unique
  createdAt           DateTime      @default(now())
  payout              FacultyPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@index([payoutId])
  @@index([eventType])
  @@index([createdAt])
}

model WeeklyFacultyPaymentRecord {
  id              String                 @id @default(cuid())
  weekStart       DateTime               @db.Date
  weekEnd         DateTime               @db.Date
  totalEntries    Int                    @default(0)
  facultyCount    Int                    @default(0)
  totalAmount     Decimal                @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal                @default(0) @db.Decimal(12, 2)
  pendingAmount   Decimal                @default(0) @db.Decimal(12, 2)
  paymentMode     String                 @default("ONLINE")
  status          String                 @default("UNPAID")
  paidAt          DateTime?
  paidByAdminId   Int?
  paidByAdminName String?
  remarks         String?
  payrollCycleId  String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  facultyRecords  FacultyPaymentRecord[]

  @@unique([weekStart, weekEnd])
  @@index([status])
  @@index([paymentMode])
  @@index([paidAt])
}

model FacultyPaymentRecord {
  id                    String                     @id @default(cuid())
  weeklyPaymentRecordId String
  facultyId             String
  facultyCode           String?
  facultyName           String?
  attendanceEntries     Int                        @default(0)
  amount                Decimal                    @default(0) @db.Decimal(12, 2)
  paymentMode           String                     @default("ONLINE")
  status                String                     @default("UNPAID")
  cashfreeTransferId    String?
  cashfreeReferenceId   String?
  utr                   String?
  transactionId         String?
  failureReason         String?
  paidAt                DateTime?
  remarks               String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  weeklyPaymentRecord   WeeklyFacultyPaymentRecord @relation(fields: [weeklyPaymentRecordId], references: [id], onDelete: Cascade)
  faculty               Faculty                    @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  @@unique([weeklyPaymentRecordId, facultyId])
  @@index([facultyId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  facultyId String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@index([isRead])
  @@index([createdAt])
}

model ExtraIncentiveType {
  id            String                       @id @default(cuid())
  name          String
  rate          Decimal                      @db.Decimal(12, 2)
  isActive      Boolean                      @default(true)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  entries       FacultyExtraIncentiveEntry[]
  onlineClasses FacultyOnlineClass[]

  @@index([isActive])
  @@index([createdAt])
}

model FacultyExtraIncentiveOperationLock {
  facultyId String @id
  leaseId String
  expiresAt DateTime
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model FacultyExtraIncentiveEntry {
  id              String                        @id @default(cuid())
  facultyId       String
  incentiveTypeId String
  quantityChange  Int
  rateSnapshot    Decimal                       @db.Decimal(12, 2)
  amountSnapshot  Decimal                       @db.Decimal(12, 2)
  status          String                        @default("PENDING")
  paymentRecordId String?
  createdByType   String
  createdById     String?
  note            String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  faculty         Faculty                       @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  incentiveType   ExtraIncentiveType            @relation(fields: [incentiveTypeId], references: [id], onDelete: Restrict)
  paymentRecord   FacultyExtraIncentivePayment? @relation(fields: [paymentRecordId], references: [id], onDelete: SetNull)
  onlineClass     FacultyOnlineClass?

  @@index([facultyId])
  @@index([incentiveTypeId])
  @@index([status])
  @@index([paymentRecordId])
  @@index([createdAt])
}

model FacultyOnlineClass {
  id               String                      @id @default(cuid())
  facultyId        String
  incentiveTypeId  String
  requestId        String
  batchName        String
  className        String
  directoryGradeId String?
  topic            String
  message          String?
  startsAt         DateTime
  endsAt           DateTime?
  meetUrl          String
  status           String                      @default("SCHEDULED")
  completedAt      DateTime?
  cancelledAt      DateTime?
  deletedAt        DateTime?
  incentiveEntryId String?                     @unique
  trackingEnabled  Boolean                     @default(false)
  conferenceName   String?                     @unique
  conferenceSpace  String?
  actualStartAt    DateTime?
  actualEndAt      DateTime?
  conferenceExpiresAt DateTime?
  verificationStatus String                    @default("LEGACY")
  verificationError String?
  teacherGoogleUserId String?
  attendanceEvidence Json?
  attendanceCompleteAt DateTime?
  lastCheckedAt    DateTime?
  nextCheckAt      DateTime?
  pollAttempts     Int                         @default(0)
  pollLeaseToken   String?
  pollLeaseUntil   DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  faculty          Faculty                     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  incentiveType    ExtraIncentiveType          @relation(fields: [incentiveTypeId], references: [id], onDelete: Restrict)
  incentiveEntry   FacultyExtraIncentiveEntry? @relation(fields: [incentiveEntryId], references: [id], onDelete: SetNull)
  directoryGrade   OnlineClassGrade?           @relation(fields: [directoryGradeId], references: [id], onDelete: Restrict)
  batches          FacultyOnlineClassBatch[]

  @@unique([facultyId, requestId])
  @@index([facultyId, startsAt, id])
  @@index([incentiveTypeId])
  @@index([directoryGradeId])
  @@index([trackingEnabled, nextCheckAt])
}

model OnlineClassBatch {
  id             String             @id @default(cuid())
  name           String
  normalizedName String             @unique
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  grades         OnlineClassGrade[]
  sessions       FacultyOnlineClassBatch[]
}

model FacultyOnlineClassBatch {
  classId String
  batchId String
  nameSnapshot String
  onlineClass FacultyOnlineClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  batch OnlineClassBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@id([classId, batchId])
  @@index([batchId])
}

model OnlineClassGrade {
  id             String               @id @default(cuid())
  batchId        String
  name           String
  normalizedName String
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  batch          OnlineClassBatch     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  onlineClasses  FacultyOnlineClass[]

  @@unique([batchId, normalizedName])
}

model FacultyExtraIncentivePayment {
  id                  String                       @id @default(cuid())
  facultyId           String
  totalAmount         Decimal                      @db.Decimal(12, 2)
  status              String                       @default("PAID")
  paymentMethod       String                       @default("CASH")
  facultyPayoutId     String?
  cashfreeTransferId  String?
  cashfreeReferenceId String?
  utr                 String?
  transactionId       String?
  failureReason       String?
  paidByAdminId       Int
  paidByAdminName     String?
  paidAt              DateTime                     @default(now())
  summaryJson         Json?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  faculty             Faculty                      @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  entries             FacultyExtraIncentiveEntry[]

  @@index([facultyId])
  @@index([status])
  @@index([paidAt])
}

model ProfilePicture {
  id        String   @id @default(cuid())
  facultyId String
  imageUrl  String
  createdAt DateTime @default(now())
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([facultyId])
  @@index([createdAt])
}

model Payment {
  id                   Int                   @id @default(autoincrement())
  month                String
  academicYear         Int
  amount               Int
  currency             String                @default("INR")
  status               String                @default("created")
  paymentProvider      PaymentProvider?
  paidAt               DateTime?
  isLatePayment        Boolean               @default(false)
  phonepeTransactionId String?
  phonepePaymentId     String?
  studentId            Int
  teacherAdminId       Int?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  student              Student               @relation(fields: [studentId], references: [id])
  teacherAdmin         Admin?                @relation("AdminPayments", fields: [teacherAdminId], references: [id])
  gatewayOrders        PaymentGatewayOrder[]

  @@unique([studentId, month, academicYear])
  @@index([studentId, academicYear, createdAt])
  @@index([academicYear, month, status])
  @@index([status, createdAt])
  @@index([phonepeTransactionId])
  @@index([phonepePaymentId])
  @@index([teacherAdminId])
}

model PaymentGatewayOrder {
  id                String                @id @default(cuid())
  provider          PaymentProvider       @default(CASHFREE)
  status            GatewayPaymentStatus  @default(PENDING)
  paymentId         Int
  studentId         Int
  teacherAdminId    Int?
  amount            Int
  currency          String                @default("INR")
  month             String
  academicYear      Int
  cashfreeOrderId   String?               @unique
  cashfreeCfOrderId String?               @unique
  paymentSessionId  String?
  paymentMethodHint String?
  paymentMethod     String?
  returnUrl         String?
  notifyUrl         String?
  orderStatus       String?
  orderExpiryTime   DateTime?
  gatewayReference  String?
  metadata          Json?
  rawCreateResponse Json?
  paidAt            DateTime?
  verifiedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  payment           Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  student           Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherAdmin      Admin?                @relation("AdminGatewayOrders", fields: [teacherAdminId], references: [id], onDelete: SetNull)
  attempts          PaymentAttempt[]
  webhookEvents     PaymentWebhookEvent[]

  @@index([paymentId, status])
  @@index([studentId, month, academicYear])
  @@index([teacherAdminId])
}

model PaymentAttempt {
  id                    String               @id @default(cuid())
  gatewayOrderId        String
  provider              PaymentProvider      @default(CASHFREE)
  status                GatewayPaymentStatus @default(PENDING)
  cashfreeOrderId       String?
  cfPaymentId           String?              @unique
  paymentGroup          String?
  paymentMethod         String?
  paymentMessage        String?
  bankReference         String?
  gatewayPaymentId      String?
  gatewayOrderReference String?
  paymentAmount         Float?
  paymentTime           DateTime?
  rawPayload            Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  gatewayOrder          PaymentGatewayOrder  @relation(fields: [gatewayOrderId], references: [id], onDelete: Cascade)

  @@index([gatewayOrderId, createdAt])
  @@index([cashfreeOrderId])
}

model PaymentWebhookEvent {
  id              String               @id @default(cuid())
  provider        PaymentProvider      @default(CASHFREE)
  gatewayOrderId  String?
  dedupeKey       String               @unique
  eventType       String
  cashfreeOrderId String?
  cfPaymentId     String?
  signature       String?
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime             @default(now())
  gatewayOrder    PaymentGatewayOrder? @relation(fields: [gatewayOrderId], references: [id], onDelete: SetNull)

  @@index([cashfreeOrderId])
  @@index([cfPaymentId])
}

model BackgroundJob {
  id                String              @id @default(cuid())
  type              BackgroundJobType
  status            BackgroundJobStatus @default(PENDING)
  source            String
  requestedByRole   String?
  requestedByUserId Int?
  dedupeKey         String?             @unique
  payload           Json?
  totalItems        Int                 @default(0)
  processedItems    Int                 @default(0)
  succeededItems    Int                 @default(0)
  failedItems       Int                 @default(0)
  errorMessage      String?
  result            Json?
  startedAt         DateTime?
  completedAt       DateTime?
  lastHeartbeatAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([type, status])
  @@index([requestedByRole, requestedByUserId])
}

model AppSettings {
  id         Int @id @default(1)
  monthlyFee Int
}

